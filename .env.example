# Copie ce fichier en ".env" et remplis seulement ce dont tu as besoin.

# Uniquement si fournisseur = "api" dans config.toml
# (clé à créer sur https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Uniquement si moteur = "elevenlabs" dans [voix] (https://elevenlabs.io → Profil → API Keys)
ELEVENLABS_API_KEY=

# Uniquement si methode = "bot" dans [discord] (voir le README)
DISCORD_BOT_TOKEN=
